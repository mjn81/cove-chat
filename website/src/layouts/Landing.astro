---
import '../styles/tokens.css';
import '../styles/landing.css';
import '../styles/sections.css';
import '../styles/responsive.css';
import Nav from '../components/landing/Nav';
import Footer from '../components/landing/Footer.astro';
import { getReleaseInfo } from '../lib/github';
import { APP_NAME, REPO_URL, url } from '../lib/site';
import { LANGS, LANG_META, dict, localUrl, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path without language prefix, starting with `/`. */
  path?: string;
}
const { lang, title, description, path = '/' } = Astro.props;
const info = await getReleaseInfo();
const d = dict(lang).nav;
const abs = (p: string) => new URL(p, Astro.site).href;
const canonical = abs(localUrl(lang, path));
const ogImage = abs(url('/og.png'));
const ogLocale: Record<Lang, string> = { en: 'en_US', fa: 'fa_IR', ar: 'ar_AR' };
const links = [
  { label: d.features, href: localUrl(lang, '/#features') },
  { label: d.docs, href: localUrl(lang, '/docs/') },
  { label: d.roadmap, href: localUrl(lang, '/roadmap/') },
  { label: d.download, href: localUrl(lang, '/download/') },
];

const author = { '@type': 'Person', name: 'mjn', url: 'https://github.com/mjn81' };
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: APP_NAME,
    url: abs(localUrl(lang, '/')),
    inLanguage: lang,
    description,
    publisher: author,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: APP_NAME,
    applicationCategory: 'CommunicationApplication',
    operatingSystem: 'Windows, macOS, Linux, Android',
    description,
    url: abs(localUrl(lang, '/')),
    image: ogImage,
    inLanguage: lang,
    softwareVersion: info.tag ?? undefined,
    codeRepository: REPO_URL,
    license: 'https://opensource.org/licenses/MIT',
    author,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
];
if (path !== '/') {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: APP_NAME, item: abs(localUrl(lang, '/')) },
      { '@type': 'ListItem', position: 2, name: title, item: canonical },
    ],
  });
}
---
<!doctype html>
<html lang={lang} dir={LANG_META[lang].dir} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="author" content="mjn" />
    <meta name="theme-color" content="#23201f" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(localUrl(l, path))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(localUrl('en', path))} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={APP_NAME} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cove: self-hosted encrypted chat" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
    <!-- Runs before paint so the saved (or system) theme never flashes. Same key as Starlight. -->
    <script is:inline>
      (function () {
        let t = null;
        try { t = localStorage.getItem('starlight-theme'); } catch {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body class="landing">
    <a class="skip-link" href="#main">{d.skip}</a>
    <Nav client:load links={links} stars={info.stars} lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer version={info.tag} lang={lang} />
  </body>
  <script>
    // Inertial smooth scrolling for the marketing pages (not the docs). Skipped for reduced motion.
    import Lenis from 'lenis';

    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const lenis = new Lenis({ anchors: { offset: -88 }, lerp: 0.1 });
      const raf = (t: number) => {
        lenis.raf(t);
        requestAnimationFrame(raf);
      };
      requestAnimationFrame(raf);
    }
  </script>
</html>
