---
import Home from '../../views/Home.astro';
import { LANGS, type Lang } from '../../i18n';

// English is served at the site root (no param); the others get /fa/, /ar/ and /ru/.
export function getStaticPaths() {
  return LANGS.map((l) => ({ params: { lang: l === 'en' ? undefined : l }, props: { lang: l } }));
}
const { lang } = Astro.props as { lang: Lang };
---
<Home lang={lang} />
