<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.NodeTalk" parent="android:Theme.Material.NoActionBar">
        <!-- Match NodeTalk dark window background from web client -->
        <item name="android:windowBackground">@color/nt_background</item>
        <item name="android:statusBarColor">@color/nt_popover</item>
        <item name="android:navigationBarColor">@color/nt_popover</item>
        
        <!-- Light icons on dark status/nav bars -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>
