# Copy to .env on the server (chmod 600). Never commit the real file.
INSTANCE=staging
INSTANCE_HOST=staging.covechat.dev
MEDIA_PORT_MIN=50200
MEDIA_PORT_MAX=50300
# Staging runs without the embedded TURN relay (the demo owns UDP 3478), so this port is unused.
TURN_PORT=3479
SERVER_MEM=512m
SERVER_CPUS=1
COVE_MASTER_PASSWORD=change-me-long-random
