# One block per instance. Caddy forwards the real client IP in X-Forwarded-For and overwrites any value
# the client sent, which is why the instances run with trust_proxy_headers = true.
(cove_instance) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# The API and the WebSocket go to the server; every other path is the web client.
	@backend path /api/* /ws /ws/*
	handle @backend {
		reverse_proxy {args[0]} {
			# Calls and long-lived sockets must not be cut by an idle timeout.
			transport http {
				read_timeout 1h
				write_timeout 1h
			}
		}
	}
	handle {
		reverse_proxy {args[1]}
	}
}

demo.covechat.dev {
	import cove_instance cove-demo-server:4000 cove-demo-web:80
}
