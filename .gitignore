.DS_Store
*.log
/backend/data/
config.toml
# Instance configs under ops/ hold no secrets (those live in .env on the server) and are deployed from the repo.
!ops/instances/*/config.toml
cove-server
stress_report_*.txt
.env
.server.env

# config backups written by the admin panel (contain secrets)
*.toml.bak

# Local env files (use .env.example as the template)
.env.local
.env.*.local
!.env.example

# Build outputs and release artifacts
*.exe
/release/
/client-desktop/build/bin/
/client-desktop/desktop
# Copied from client-web/dist by `make wails/*`; the placeholder keeps `//go:embed all:frontend/dist` compiling.
/client-desktop/frontend/dist/*
!/client-desktop/frontend/dist/.gitkeep

# Go test / profiling output
*.out
*.test
*.prof

# OS and editor noise
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
