# Cove web client environment. Copy to `.env.local` (git-ignored) for local overrides.
# Vite only exposes variables prefixed with VITE_ to the browser, so never put secrets here.

# Public URL of the Cove server API the web client talks to.
# - Local dev: leave as is; the client matches the page's own hostname (localhost vs 127.0.0.1)
#   and only takes the port from this value.
# - Production: set to your public API URL, for example https://chat.example.com
# - Docker image: set VITE_API_URL on the container instead; it is substituted at start-up.
VITE_API_URL=http://localhost:4000

